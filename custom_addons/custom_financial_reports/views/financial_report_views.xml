<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_financial_report_bs" model="ir.actions.client">
        <field name="name">Balance Sheet</field>
        <field name="tag">custom_financial_reports.report_view</field>
        <field name="context">{'report_type': 'bs'}</field>
    </record>

    <record id="action_financial_report_pl" model="ir.actions.client">
        <field name="name">Profit and Loss</field>
        <field name="tag">custom_financial_reports.report_view</field>
        <field name="context">{'report_type': 'pl'}</field>
    </record>

    <record id="action_financial_report_cf" model="ir.actions.client">
        <field name="name">Cash Flow Statement</field>
        <field name="tag">custom_financial_reports.report_view</field>
        <field name="context">{'report_type': 'cf'}</field>
    </record>

    <menuitem id="menu_financial_statements"
              name="Financial Statements"
              parent="account.menu_finance_reports"
              groups="account.group_account_invoice"
              sequence="5"/>
    <menuitem id="menu_financial_report_bs"
              action="action_financial_report_bs"
              parent="menu_financial_statements"
              sequence="1"/>
    <menuitem id="menu_financial_report_pl"
              action="action_financial_report_pl"
              parent="menu_financial_statements"
              sequence="2"/>
    <menuitem id="menu_financial_report_cf"
              action="action_financial_report_cf"
              parent="menu_financial_statements"
              sequence="3"/>
</odoo>
