<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_financial_report_wizard_form" model="ir.ui.view">
        <field name="name">custom.financial.report.wizard.form</field>
        <field name="model">custom.financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Financial Report">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_from"
                               invisible="report_type == 'bs'"
                               required="report_type != 'bs'"/>
                        <field name="date_to"
                               string="As of Date"
                               invisible="report_type != 'bs'"/>
                        <field name="date_to"
                               invisible="report_type == 'bs'"/>
                    </group>
                    <group>
                        <field name="target_move" widget="radio"/>
                        <field name="comparison"/>
                        <field name="detail_level" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF"
                            type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button name="action_export_xlsx" string="Export XLSX"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_financial_report_bs" model="ir.actions.act_window">
        <field name="name">Balance Sheet</field>
        <field name="res_model">custom.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'bs'}</field>
    </record>

    <record id="action_financial_report_pl" model="ir.actions.act_window">
        <field name="name">Profit and Loss</field>
        <field name="res_model">custom.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'pl'}</field>
    </record>

    <record id="action_financial_report_cf" model="ir.actions.act_window">
        <field name="name">Cash Flow Statement</field>
        <field name="res_model">custom.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'cf'}</field>
    </record>

    <menuitem id="menu_financial_statements"
              name="Financial Statements"
              parent="account.menu_finance_reports"
              groups="account.group_account_readonly"
              sequence="5"/>
    <menuitem id="menu_financial_report_bs"
              action="action_financial_report_bs"
              parent="menu_financial_statements"
              sequence="1"/>
    <menuitem id="menu_financial_report_pl"
              action="action_financial_report_pl"
              parent="menu_financial_statements"
              sequence="2"/>
    <menuitem id="menu_financial_report_cf"
              action="action_financial_report_cf"
              parent="menu_financial_statements"
              sequence="3"/>
</odoo>
