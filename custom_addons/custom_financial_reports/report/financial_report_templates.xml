<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_financial">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="d" t-value="render"/>
                <div class="page">
                    <h2 t-out="d['title']"/>
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong t-out="d['company_name']"/><br/>
                            <span t-out="d['periods'][0]['label']"/>
                        </div>
                        <div class="col-6 text-end">
                            <span>Target Moves: </span>
                            <span t-out="d['target_move_label']"/>
                        </div>
                    </div>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th t-foreach="d['periods']" t-as="period"
                                    class="text-end" style="width: 16%;"
                                    t-out="period['label']"/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="d['lines']" t-as="line">
                                <tr t-if="line['type'] == 'spacer'">
                                    <td t-att-colspan="len(d['periods']) + 1"
                                        style="border: 0;">&#160;</td>
                                </tr>
                                <tr t-else="">
                                    <td>
                                        <span t-attf-style="padding-left: {{ line['level'] * 18 }}px;"
                                              t-attf-class="{{ 'fw-bold' if line['type'] in ('section', 'header', 'total', 'grand_total') else '' }} {{ 'text-muted small' if line['type'] == 'account' else '' }}"
                                              t-out="line['name']"/>
                                    </td>
                                    <td t-foreach="line['amounts']" t-as="value" class="text-end">
                                        <span t-if="value is not None"
                                              t-attf-class="{{ 'fw-bold' if line['type'] in ('section', 'total', 'grand_total') else '' }} {{ 'text-muted small' if line['type'] == 'account' else '' }}"
                                              t-out="value"
                                              t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
