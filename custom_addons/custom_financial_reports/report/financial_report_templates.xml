<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_financial">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="d" t-value="render_data[o.id]"/>
                    <div class="page">
                        <h2 t-out="d['title']"/>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong t-out="o.company_id.name"/><br/>
                                <span t-out="d['periods'][0]['label']"/>
                            </div>
                            <div class="col-6 text-end">
                                <span>Target Moves: </span>
                                <span t-out="d['target_move_label']"/>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end" style="width: 18%;"
                                        t-out="d['periods'][0]['label']"/>
                                    <th t-if="d['has_comparison']"
                                        class="text-end" style="width: 18%;"
                                        t-out="d['periods'][1]['label']"/>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="d['lines']" t-as="line">
                                    <tr t-if="line['type'] == 'spacer'">
                                        <td t-att-colspan="d['has_comparison'] and 3 or 2"
                                            style="border: 0;">&#160;</td>
                                    </tr>
                                    <tr t-else="">
                                        <td>
                                            <span t-attf-style="padding-left: {{ line['level'] * 18 }}px;"
                                                  t-attf-class="{{ 'fw-bold' if line['type'] in ('section', 'header', 'total', 'grand_total') else '' }} {{ 'text-muted small' if line['type'] == 'account' else '' }}"
                                                  t-out="line['name']"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-if="line['amount'] is not None"
                                                  t-attf-class="{{ 'fw-bold' if line['type'] in ('section', 'total', 'grand_total') else '' }} {{ 'text-muted small' if line['type'] == 'account' else '' }}"
                                                  t-out="line['amount']"
                                                  t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                        </td>
                                        <td t-if="d['has_comparison']" class="text-end">
                                            <span t-if="line['amount'] is not None"
                                                  t-attf-class="{{ 'fw-bold' if line['type'] in ('section', 'total', 'grand_total') else '' }} {{ 'text-muted small' if line['type'] == 'account' else '' }}"
                                                  t-out="line.get('amount_cmp', 0.0)"
                                                  t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
