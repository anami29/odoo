<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override login template to make form visible by default -->
    <template id="login" inherit_id="web.login">
        <xpath expr="//form" position="attributes">
            <attribute name="t-attf-class">oe_login_form</attribute>
        </xpath>
    </template>
</odoo>

