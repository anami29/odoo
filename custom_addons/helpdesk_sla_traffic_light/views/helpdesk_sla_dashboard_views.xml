<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Window action for expired SLA tickets to display on the dashboard -->
    <record id="action_helpdesk_ticket_expired_dashboard" model="ir.actions.act_window">
        <field name="name">Expired SLA Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sla_status', '=', 'expired')]</field>
        <field name="context">{'search_default_my_tickets': 1}</field>
    </record>

    <!-- Custom Dashboard (Board) View definition -->
    <record id="helpdesk_sla_dashboard_view" model="ir.ui.view">
        <field name="name">helpdesk.sla.dashboard.view</field>
        <field name="model">board.board</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Helpdesk SLA &amp; AHT Dashboard">
                <board style="2-1">
                    <!-- Left Column (Wide) -->
                    <column>
                        <!-- AHT Report Graph -->
                        <action string="Average Handling Time (Graph)"
                                name="%(helpdesk_sla_traffic_light.action_helpdesk_ticket_report_aht)d"
                                view_mode="graph"/>
                        <!-- AHT Report Pivot -->
                        <action string="Average Handling Time (Pivot)"
                                name="%(helpdesk_sla_traffic_light.action_helpdesk_ticket_report_aht)d"
                                view_mode="pivot"/>
                    </column>
                    <!-- Right Column (Narrow) -->
                    <column>
                        <!-- Tickets Analysis Pivot -->
                        <action string="Tickets by Stage &amp; Team (Pivot)"
                                name="%(helpdesk_mgmt.helpdesk_ticket_reporting_action)d"
                                view_mode="pivot"/>
                        <!-- Expired SLA Tickets List -->
                        <action string="Expired SLA Tickets (Needs Attention)"
                                name="%(helpdesk_sla_traffic_light.action_helpdesk_ticket_expired_dashboard)d"
                                view_mode="list"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <!-- Window Action to open the SLA Dashboard -->
    <record id="action_helpdesk_sla_dashboard" model="ir.actions.act_window">
        <field name="name">SLA Dashboard</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="usage">menu</field>
        <field name="view_id" ref="helpdesk_sla_dashboard_view"/>
    </record>

    <!-- Menu Item for SLA Dashboard placed under Reporting menu -->
    <menuitem id="helpdesk_sla_dashboard_menu"
              name="SLA Dashboard"
              parent="helpdesk_mgmt.helpdesk_ticket_reporting_menu"
              action="action_helpdesk_sla_dashboard"
              sequence="1"
              groups="helpdesk_mgmt.group_helpdesk_manager"/>
</odoo>
