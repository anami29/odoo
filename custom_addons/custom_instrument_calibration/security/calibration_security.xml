<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_calibration" model="ir.module.category">
        <field name="name">Calibration</field>
        <field name="sequence">55</field>
    </record>
    <record id="group_calibration_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_calibration"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_calibration_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_calibration"/>
        <field name="implied_ids" eval="[(4, ref('group_calibration_user'))]"/>
    </record>

    <record id="rule_instrument_company" model="ir.rule">
        <field name="name">Instrument: multi-company</field>
        <field name="model_id" ref="model_calibration_instrument"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_order_company" model="ir.rule">
        <field name="name">Calibration Order: multi-company</field>
        <field name="model_id" ref="model_calibration_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_disposition_company" model="ir.rule">
        <field name="name">Disposition: multi-company</field>
        <field name="model_id" ref="model_calibration_record_disposition"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
