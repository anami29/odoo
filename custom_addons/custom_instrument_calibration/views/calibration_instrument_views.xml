<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_instrument_list" model="ir.ui.view">
        <field name="name">calibration.instrument.list</field>
        <field name="model">calibration.instrument</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'due'"
                  decoration-danger="state in ('overdue', 'quarantine')"
                  decoration-muted="state in ('retired', 'scrapped', 'lost')">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="custodian_id"/>
                <field name="location" optional="hide"/>
                <field name="last_calibration_date" optional="show"/>
                <field name="certificate_valid_until" optional="hide"/>
                <field name="effective_due_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'in_use'"
                       decoration-warning="state == 'due'"
                       decoration-danger="state in ('overdue', 'quarantine')"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_instrument_form" model="ir.ui.view">
        <field name="name">calibration.instrument.form</field>
        <field name="model">calibration.instrument</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_historical_wizard)d" type="action"
                            string="Record Historical Calibration"
                            invisible="state != 'draft'"
                            groups="custom_instrument_calibration.group_calibration_manager"
                            context="{'default_instrument_id': id}"/>
                    <button name="action_plan_calibration" type="object"
                            string="Plan Calibration"
                            invisible="state in ('draft', 'retired', 'scrapped', 'lost')"/>
                    <button name="%(action_damage_wizard)d" type="action"
                            string="Report Damage" class="btn-warning"
                            invisible="state not in ('in_use', 'due', 'overdue')"
                            context="{'default_instrument_id': id}"/>
                    <button name="%(action_retirement_wizard)d" type="action"
                            string="Request Retirement"
                            invisible="retirement_state == 'pending' or state in ('draft', 'retired', 'scrapped', 'lost')"
                            context="{'default_instrument_id': id}"/>
                    <button name="action_approve_retirement" type="object"
                            string="Approve Retirement" class="btn-primary"
                            invisible="retirement_state != 'pending'"
                            groups="custom_instrument_calibration.group_calibration_manager"/>
                    <button name="action_reject_retirement" type="object"
                            string="Reject Retirement"
                            invisible="retirement_state != 'pending'"
                            groups="custom_instrument_calibration.group_calibration_manager"/>
                    <button name="action_scrap" type="object" string="Scrap"
                            invisible="state != 'retired'"
                            groups="custom_instrument_calibration.group_calibration_manager"/>
                    <button name="action_reactivate" type="object" string="Reactivate"
                            invisible="state not in ('retired', 'lost')"
                            groups="custom_instrument_calibration.group_calibration_manager"/>
                    <button name="%(action_state_override_wizard)d" type="action"
                            string="Override State"
                            groups="custom_instrument_calibration.group_calibration_manager"
                            context="{'default_instrument_id': id}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_use,due,overdue,under_calibration"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="DO NOT USE" bg_color="text-bg-danger"
                            invisible="state not in ('overdue', 'quarantine', 'retired', 'scrapped', 'lost')"/>
                    <widget name="web_ribbon" title="Pending Retirement Approval"
                            bg_color="text-bg-warning"
                            invisible="retirement_state != 'pending'"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not restricted_use">
                        Restricted use: <field name="restriction_note" readonly="1"
                                               class="oe_inline"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_calibrations" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="calibration_count" widget="statinfo"
                                   string="Calibrations"/>
                        </button>
                        <button name="action_view_certificates" type="object"
                                class="oe_stat_button" icon="fa-certificate">
                            <field name="certificate_count" widget="statinfo"
                                   string="Certificates"/>
                        </button>
                        <button name="action_print_label" type="object"
                                class="oe_stat_button" icon="fa-qrcode"
                                string="Label"/>
                        <button name="action_audit_bundle" type="object"
                                class="oe_stat_button" icon="fa-file-pdf-o"
                                string="Audit Bundle"/>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1" placeholder="Auto"/></h1>
                        <h2><field name="name" placeholder="Instrument description"/></h2>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category_id"/>
                            <field name="instrument_type"/>
                            <field name="is_master_standard"/>
                            <field name="calibration_procedure_ref"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Identity">
                            <field name="make"/>
                            <field name="model_no"/>
                            <field name="serial_no"/>
                            <label for="range_min" string="Range"/>
                            <div class="o_row">
                                <field name="range_min"/> –
                                <field name="range_max"/>
                                <field name="range_uom_id"/>
                            </div>
                            <field name="least_count"/>
                            <field name="accuracy_class"/>
                        </group>
                        <group string="Responsibility">
                            <field name="custodian_id"/>
                            <field name="department_id"/>
                            <field name="location"/>
                        </group>
                        <group string="Calibration Plan">
                            <field name="calibration_type"/>
                            <label for="frequency_interval" string="Frequency"/>
                            <div class="o_row">
                                <field name="frequency_interval"/>
                                <field name="frequency_uom"/>
                            </div>
                            <field name="lead_days"/>
                        </group>
                        <group string="Certification Status">
                            <field name="last_calibration_date"/>
                            <field name="last_certificate_no"/>
                            <field name="certificate_valid_until"/>
                            <field name="next_due_date"/>
                            <field name="effective_due_date"/>
                        </group>
                        <group string="Procurement">
                            <field name="purchase_date"/>
                            <field name="vendor_id"/>
                            <field name="purchase_cost"/>
                            <field name="purchase_ref"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Safeguarding">
                            <field name="safeguard_note"
                                   placeholder="Handling and safeguarding instructions..."/>
                        </page>
                        <page string="Retirement / Disposal"
                              invisible="state not in ('retired', 'scrapped', 'lost') and retirement_state != 'pending'">
                            <group>
                                <group>
                                    <field name="retirement_reason_id" readonly="1"/>
                                    <field name="retirement_remarks" readonly="1"/>
                                    <field name="retirement_date"/>
                                    <field name="retirement_user_id"/>
                                    <field name="end_of_life_date"/>
                                </group>
                                <group>
                                    <field name="disposal_ref"
                                           readonly="state == 'scrapped'"/>
                                    <field name="disposal_date"/>
                                    <field name="lost_reason"
                                           invisible="state != 'lost'"/>
                                    <field name="retirement_photo" widget="image"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_instrument_kanban" model="ir.ui.view">
        <field name="name">calibration.instrument.kanban</field>
        <field name="model">calibration.instrument</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="code"/></strong> —
                            <field name="name"/>
                            <div class="text-muted">
                                <field name="category_id"/> ·
                                <field name="custodian_id"/>
                            </div>
                            <div>Eff. due: <field name="effective_due_date"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_instrument_calendar" model="ir.ui.view">
        <field name="name">calibration.instrument.calendar</field>
        <field name="model">calibration.instrument</field>
        <field name="arch" type="xml">
            <calendar date_start="effective_due_date" color="category_id"
                      event_open_popup="1" quick_create="0">
                <field name="code"/>
                <field name="name"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_instrument_pivot" model="ir.ui.view">
        <field name="name">calibration.instrument.pivot</field>
        <field name="model">calibration.instrument</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_instrument_graph" model="ir.ui.view">
        <field name="name">calibration.instrument.graph</field>
        <field name="model">calibration.instrument</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="category_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_instrument_activity" model="ir.ui.view">
        <field name="name">calibration.instrument.activity</field>
        <field name="model">calibration.instrument</field>
        <field name="arch" type="xml">
            <activity string="Instruments">
                <templates>
                    <div t-name="activity-box">
                        <div><field name="code" display="full"/></div>
                        <div><field name="name" muted="1" display="full"/></div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="view_instrument_search" model="ir.ui.view">
        <field name="name">calibration.instrument.search</field>
        <field name="model">calibration.instrument</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="serial_no"/>
                <field name="custodian_id"/>
                <field name="category_id"/>
                <filter name="f_in_use" string="In Use"
                        domain="[('state', '=', 'in_use')]"/>
                <filter name="f_due" string="Due"
                        domain="[('state', '=', 'due')]"/>
                <filter name="f_overdue" string="Overdue"
                        domain="[('state', '=', 'overdue')]"/>
                <filter name="f_quarantine" string="Quarantine"
                        domain="[('state', '=', 'quarantine')]"/>
                <filter name="f_masters" string="Master Standards"
                        domain="[('is_master_standard', '=', True)]"/>
                <separator/>
                <filter name="f_due_month" string="Due This Month"
                        domain="[('effective_due_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('effective_due_date', '&lt;',
                                  (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="f_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="g_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="g_custodian" string="Custodian"
                            context="{'group_by': 'custodian_id'}"/>
                    <filter name="g_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_calibration_instrument" model="ir.actions.act_window">
        <field name="name">Instruments</field>
        <field name="res_model">calibration.instrument</field>
        <field name="view_mode">list,kanban,form,calendar,activity,pivot,graph</field>
        <field name="search_view_id" ref="view_instrument_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first instrument</p>
        </field>
    </record>
</odoo>
