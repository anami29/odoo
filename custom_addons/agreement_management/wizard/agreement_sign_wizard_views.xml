<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agreement_sign_wizard_view_form" model="ir.ui.view">
        <field name="name">agreement.sign.wizard.form</field>
        <field name="model">agreement.sign.wizard</field>
        <field name="arch" type="xml">
            <form string="Signing Screen">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="party" invisible="1"/>
                <field name="all_required_signed" invisible="1"/>
                <field name="signatory_name" invisible="1"/>
                <div class="alert alert-info mb-3" role="status">
                    <strong><field name="document_label" readonly="1" class="d-inline"/> <field name="document_name" readonly="1" class="d-inline"/></strong>
                    — signing as <strong><field name="party_label" readonly="1" class="d-inline"/></strong>:
                    <field name="signatory_id" readonly="1" class="d-inline" options="{'no_open': True}"/>
                    for <field name="party_partner_id" readonly="1" class="d-inline" options="{'no_open': True}"/>.
                    Every required area assigned to this party must be signed before signing can be completed.
                    Touch, stylus and pen-tablet input are supported.
                </div>
                <group>
                    <group string="Adopted signature">
                        <field name="master_signature" widget="signature" options="{'full_name': 'signatory_name', 'size': [420, 150]}" nolabel="1" colspan="2"/>
                        <div colspan="2">
                            <button name="action_apply_master" type="object" string="Apply adopted signature to all remaining areas" class="btn-secondary" icon="fa-bolt"/>
                            <button name="action_clear" type="object" string="Clear all" class="btn-link" icon="fa-eraser"/>
                        </div>
                    </group>
                    <group string="Progress">
                        <field name="signed_count" string="Required areas signed"/>
                        <field name="required_count" string="Required areas total"/>
                        <field name="optional_signed_count" string="Optional areas signed"/>
                        <field name="optional_count" string="Optional areas total"/>
                    </group>
                </group>
                <label for="line_ids" string="Signature areas assigned to this party — open a line to sign it individually"/>
                <field name="line_ids" nolabel="1" colspan="2">
                    <list create="0" delete="0" decoration-success="is_signed" decoration-muted="not required and not is_signed">
                        <field name="sequence" column_invisible="1"/>
                        <field name="code"/>
                        <field name="page"/>
                        <field name="name"/>
                        <field name="position" optional="hide"/>
                        <field name="kind"/>
                        <field name="required"/>
                        <field name="is_signed" string="Signed"/>
                        <field name="signature" widget="image" options="{'size': [120, 40]}"/>
                    </list>
                    <form string="Sign area">
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="page" readonly="1"/>
                                <field name="position" readonly="1"/>
                            </group>
                            <group>
                                <field name="kind" readonly="1"/>
                                <field name="required" readonly="1"/>
                                <field name="signatory_name" readonly="1"/>
                            </group>
                        </group>
                        <div class="text-muted mb-2">Sign with your finger, stylus or mouse. The signature is stored with a timestamp, the signatory identity and the IP address.</div>
                        <field name="signature" widget="signature" options="{'full_name': 'signatory_name', 'size': [640, 220]}" nolabel="1"/>
                    </form>
                </field>
                <group>
                    <field name="confirm_identity"/>
                </group>
                <footer>
                    <button name="action_complete" type="object" string="Complete Signing" class="btn-primary" icon="fa-check-circle" invisible="not all_required_signed"/>
                    <span class="text-muted me-2" invisible="all_required_signed"><i class="fa fa-lock me-1"/>Sign every required area to enable completion</span>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
