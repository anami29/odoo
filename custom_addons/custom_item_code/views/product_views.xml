<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template form: Item Code above the Internal Reference; relabel the
         latter per guidelines s.7 (two-key model made visible). -->
    <record id="product_template_only_form_view_item_code" model="ir.ui.view">
        <field name="name">product.template.form.item.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="before">
                <field name="item_code"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Legacy / Drawing Code</attribute>
                <attribute name="placeholder">e.g. DRG-A4-2214</attribute>
            </xpath>
        </field>
    </record>

    <!-- Variant form -->
    <record id="product_normal_form_view_item_code" model="ir.ui.view">
        <field name="name">product.product.form.item.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="before">
                <field name="item_code"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Legacy / Drawing Code</attribute>
                <attribute name="placeholder">e.g. DRG-A4-2214</attribute>
            </xpath>
        </field>
    </record>

    <!-- Template list -->
    <record id="product_template_tree_view_item_code" model="ir.ui.view">
        <field name="name">product.template.list.item.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="before">
                <field name="item_code" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Legacy / Drawing Code</attribute>
            </xpath>
        </field>
    </record>

    <!-- Variant list -->
    <record id="product_product_tree_view_item_code" model="ir.ui.view">
        <field name="name">product.product.list.item.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="before">
                <field name="item_code" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Legacy / Drawing Code</attribute>
            </xpath>
        </field>
    </record>

    <!-- Search views: explicit Item Code option in the search dropdown.
         The main search box already resolves codes via _name_search. -->
    <record id="product_template_search_view_item_code" model="ir.ui.view">
        <field name="name">product.template.search.item.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="item_code"/>
            </xpath>
        </field>
    </record>

    <record id="product_search_form_view_item_code" model="ir.ui.view">
        <field name="name">product.product.search.item.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="item_code"/>
            </xpath>
        </field>
    </record>

</odoo>
