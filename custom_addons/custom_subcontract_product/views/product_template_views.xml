<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_jw" model="ir.ui.view">
        <field name="name">product.template.form.jobwork</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Fourth pseudo-type radio replaces the standard selector
                 visually; the data model keeps the core type field. -->
            <field name="type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="type" position="before">
                <field name="product_kind" widget="radio"
                       options="{'horizontal': true}"/>
                <field name="l10n_in_is_jobwork" invisible="1"/>
                <field name="l10n_in_goods_hsn_code" invisible="product_kind != 'subcontract'" required="product_kind == 'subcontract'"/>
                <field name="l10n_in_jw_auto_return" invisible="not is_storable"/>
            </field>
        </field>
    </record>
</odoo>
