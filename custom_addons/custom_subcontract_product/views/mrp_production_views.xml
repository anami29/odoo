<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_jw" model="ir.ui.view">
        <field name="name">mrp.production.form.jobwork</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="subcontract_owner_id"
                       readonly="state not in ('draft', 'confirmed')"
                       groups="mrp.group_mrp_manager"/>
                <field name="subcontract_owner_id" readonly="1"
                       groups="!mrp.group_mrp_manager"/>
            </field>
        </field>
    </record>
</odoo>
