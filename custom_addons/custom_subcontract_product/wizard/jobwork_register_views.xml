<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="jobwork_register_wizard_form" model="ir.ui.view">
        <field name="name">jobwork.register.wizard.form</field>
        <field name="model">jobwork.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Job Work Reconciliation Register">
                <group>
                    <group>
                        <field name="period_mode" widget="radio"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="principal_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate XLSX" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
