<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_quality_sla" model="ir.cron">
        <field name="name">Quality: inspection SLA escalation</field>
        <field name="model_id" ref="model_quality_inspection_set"/>
        <field name="state">code</field>
        <field name="code">model._cron_sla_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_quality_capa_overdue" model="ir.cron">
        <field name="name">Quality: CAPA overdue escalation</field>
        <field name="model_id" ref="model_quality_capa"/>
        <field name="state">code</field>
        <field name="code">model._cron_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_quality_qualification_expiry" model="ir.cron">
        <field name="name">Quality: inspector qualification expiry</field>
        <field name="model_id" ref="model_quality_inspector_qualification"/>
        <field name="state">code</field>
        <field name="code">model._cron_expiry_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
