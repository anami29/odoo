<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grr_form" model="ir.ui.view">
        <field name="name">quality.grr.study.form</field>
        <field name="model">quality.grr.study</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Compute ANOVA"
                            class="btn-primary"
                            groups="custom_quality_inspection.group_quality_engineer"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="parameter"/>
                            <field name="instrument_note"/>
                            <field name="uom_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="parts"/>
                            <field name="appraisers"/>
                            <field name="trials"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="part_no"/>
                            <field name="appraiser_id"/>
                            <field name="trial"/>
                            <field name="value"/>
                        </list>
                    </field>
                    <group string="Results (AIAG)">
                        <group>
                            <field name="var_repeat"/>
                            <field name="var_reprod"/>
                            <field name="var_part"/>
                        </group>
                        <group>
                            <field name="grr_pct"/>
                            <field name="contrib_pct"/>
                            <field name="ndc"/>
                            <field name="verdict" widget="badge"
                                   decoration-success="verdict == 'acceptable'"
                                   decoration-warning="verdict == 'conditional'"
                                   decoration-danger="verdict == 'unacceptable'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_grr_list" model="ir.ui.view">
        <field name="name">quality.grr.study.list</field>
        <field name="model">quality.grr.study</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parameter"/>
                <field name="grr_pct"/>
                <field name="ndc"/>
                <field name="verdict" widget="badge"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_grr" model="ir.actions.act_window">
        <field name="name">Gauge R&amp;R Studies</field>
        <field name="res_model">quality.grr.study</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
