<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rejection_analysis_pivot" model="ir.ui.view">
        <field name="name">quality.rejection.analysis.pivot</field>
        <field name="model">quality.rejection.analysis</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="defect_id" type="row"/>
                <field name="total_loss" type="measure"/>
                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_rejection_analysis_graph" model="ir.ui.view">
        <field name="name">quality.rejection.analysis.graph</field>
        <field name="model">quality.rejection.analysis</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="defect_id"/>
                <field name="total_loss" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_rejection_analysis_list" model="ir.ui.view">
        <field name="name">quality.rejection.analysis.list</field>
        <field name="model">quality.rejection.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="product_id"/>
                <field name="defect_id"/>
                <field name="cause_id"/>
                <field name="resp_type"/>
                <field name="partner_id"/>
                <field name="stage"/>
                <field name="qty" sum="Qty"/>
                <field name="total_loss" sum="Loss"/>
            </list>
        </field>
    </record>

    <record id="action_rejection_analysis" model="ir.actions.act_window">
        <field name="name">Rejection Analysis (Pareto / CoPQ)</field>
        <field name="res_model">quality.rejection.analysis</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <record id="action_register_ir" model="ir.actions.act_window">
        <field name="name">IR Register</field>
        <field name="res_model">quality.inspection.report</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_stage': 1}</field>
    </record>

    <record id="action_register_ncr" model="ir.actions.act_window">
        <field name="name">NCR / Vendor Rejection Register</field>
        <field name="res_model">quality.ncr</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_resp': 1}</field>
    </record>
</odoo>
