<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_set_form" model="ir.ui.view">
        <field name="name">quality.inspection.set.form</field>
        <field name="model">quality.inspection.set</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_evaluate" type="object" string="Evaluate Set"
                            class="btn-primary"
                            invisible="state not in ('in_progress', 'screening')"
                            groups="custom_quality_inspection.group_quality_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_progress,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Subject">
                            <field name="product_id" readonly="1"/>
                            <field name="tracking" invisible="1"/>
                            <field name="lot_id" readonly="1" invisible="tracking == 'serial'"/>
                            <field name="serial_ids" widget="many2many_tags" readonly="1"
                                   invisible="tracking != 'serial'"/>
                            <field name="lot_qty" readonly="1"/>
                            <field name="stage" readonly="1"/>
                            <field name="plan_id" readonly="1"/>
                            <field name="plan_version" readonly="1"/>
                        </group>
                        <group string="Sampling / Source">
                            <field name="basis"/>
                            <field name="sample_qty"/>
                            <field name="code_letter"/>
                            <field name="severity"/>
                            <field name="ac"/>
                            <field name="re"/>
                            <field name="skip_lot" invisible="not skip_lot"/>
                            <field name="picking_id" readonly="1"/>
                            <field name="production_id" readonly="1"/>
                            <field name="workorder_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="ncr_origin_id" readonly="1"
                                   invisible="not ncr_origin_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Result">
                            <field name="passed_count"/>
                            <field name="failed_count"/>
                            <field name="decision_user_id"/>
                            <field name="decision_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inspection Reports">
                            <field name="report_ids" readonly="1">
                                <list decoration-danger="verdict == 'fail'"
                                      decoration-success="verdict == 'pass'"
                                      decoration-muted="superseded">
                                    <field name="name"/>
                                    <field name="unit_no"/>
                                    <field name="serial_id"/>
                                    <field name="inspector_id"/>
                                    <field name="state"/>
                                    <field name="verdict"/>
                                    <field name="superseded" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="NCRs">
                            <field name="ncr_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="disposition"/>
                                    <field name="state"/>
                                    <field name="total_loss"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_set_list" model="ir.ui.view">
        <field name="name">quality.inspection.set.list</field>
        <field name="model">quality.inspection.set</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'"
                  decoration-success="state == 'accepted'">
                <field name="name"/>
                <field name="stage"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="lot_qty"/>
                <field name="basis"/>
                <field name="sample_qty"/>
                <field name="failed_count"/>
                <field name="partner_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_set_search" model="ir.ui.view">
        <field name="name">quality.inspection.set.search</field>
        <field name="model">quality.inspection.set</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <filter name="open" string="Open"
                        domain="[('state','in',('pending','in_progress','screening'))]"/>
                <separator/>
                <filter name="incoming" string="Incoming" domain="[('stage','=','incoming')]"/>
                <filter name="inprocess" string="In-Process" domain="[('stage','=','inprocess')]"/>
                <filter name="final" string="Final" domain="[('stage','=','final')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_set" model="ir.actions.act_window">
        <field name="name">Inspection Sets</field>
        <field name="res_model">quality.inspection.set</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="view_ir_form" model="ir.ui.view">
        <field name="name">quality.inspection.report.form</field>
        <field name="model">quality.inspection.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_done" type="object" string="Complete"
                            invisible="state != 'in_progress'" class="btn-primary"/>
                    <button name="action_open_supersede" type="object" string="Supersede"
                            invisible="state != 'done' or superseded"
                            groups="custom_quality_inspection.group_quality_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Superseded" bg_color="text-bg-danger"
                            invisible="not superseded"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="set_id" readonly="1"/>
                            <field name="stage" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="unit_no" readonly="1"/>
                            <field name="serial_id" readonly="1"/>
                            <field name="piece_mark" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="inspector_id" readonly="state == 'done'"/>
                            <field name="employee_id" readonly="state == 'done'"/>
                            <field name="date_start"/>
                            <field name="date_done"/>
                            <field name="verdict" widget="badge"
                                   decoration-success="verdict == 'pass'"
                                   decoration-danger="verdict == 'fail'"/>
                            <field name="superseded_by_id" invisible="not superseded"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom" create="0" delete="0"
                              decoration-danger="result == 'fail'"
                              decoration-success="result == 'pass'">
                            <field name="balloon_ref" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="char_type" readonly="1"/>
                            <field name="specification" readonly="1" optional="show"/>
                            <field name="tol_min" readonly="1"/>
                            <field name="nominal_value" readonly="1"/>
                            <field name="tol_max" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="observed_value"
                                   readonly="char_type != 'variable'"/>
                            <field name="observed_recorded" column_invisible="1"/>
                            <field name="observed_ok"
                                   readonly="char_type == 'variable'"/>
                            <field name="result"/>
                            <field name="instrument_note" optional="show"/>
                            <field name="mandatory" optional="hide"/>
                            <field name="remark" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ir_list" model="ir.ui.view">
        <field name="name">quality.inspection.report.list</field>
        <field name="model">quality.inspection.report</field>
        <field name="arch" type="xml">
            <list decoration-danger="verdict == 'fail'"
                  decoration-success="verdict == 'pass'"
                  decoration-muted="superseded">
                <field name="name"/>
                <field name="set_id"/>
                <field name="stage"/>
                <field name="product_id"/>
                <field name="unit_no"/>
                <field name="serial_id" optional="show"/>
                <field name="inspector_id"/>
                <field name="date_done" optional="show"/>
                <field name="state"/>
                <field name="verdict" widget="badge"/>
                <field name="superseded" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ir_search" model="ir.ui.view">
        <field name="name">quality.inspection.report.search</field>
        <field name="model">quality.inspection.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="serial_id"/>
                <filter name="mine" string="My Reports"
                        domain="[('inspector_id','=',uid)]"/>
                <filter name="open" string="Open" domain="[('state','!=','done')]"/>
                <filter name="failed" string="Failed" domain="[('verdict','=','fail')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_set" string="Set" context="{'group_by': 'set_id'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ir" model="ir.actions.act_window">
        <field name="name">Inspection Reports</field>
        <field name="res_model">quality.inspection.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
