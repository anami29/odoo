<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Company Rules -->
        <record id="helpdesk_ticket_report_aht_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Ticket Report AHT Company Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_report_aht" />
            <field name="global" eval="True" />
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Record Rules -->
        <record id="helpdesk_ticket_report_aht_personal_rule" model="ir.rule">
            <field name="name">Personal Ticket Reports</field>
            <field ref="model_helpdesk_ticket_report_aht" name="model_id" />
            <field name="domain_force">["|", ('user_id', '=', user.id), '&amp;', ('user_id','=',False), ('team_id', 'in', user.helpdesk_team_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user_own'))]" />
        </record>

        <record id="helpdesk_ticket_report_aht_team_rule" model="ir.rule">
            <field name="name">Team Ticket Reports</field>
            <field ref="model_helpdesk_ticket_report_aht" name="model_id" />
            <field name="domain_force">['|',('team_id','in',user.helpdesk_team_ids.ids),('team_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user_team'))]" />
        </record>

        <record id="helpdesk_ticket_report_aht_user_rule" model="ir.rule">
            <field name="name">All Ticket Reports</field>
            <field ref="model_helpdesk_ticket_report_aht" name="model_id" />
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user'))]" />
        </record>
    </data>
</odoo>
