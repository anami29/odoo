<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Pivot View -->
    <record id="helpdesk_ticket_report_aht_view_pivot" model="ir.ui.view">
        <field name="name">helpdesk.ticket.report.aht.view.pivot</field>
        <field name="model">helpdesk.ticket.report.aht</field>
        <field name="arch" type="xml">
            <pivot string="Average Handling Time Analysis" disable_linking="True">
                <field name="team_id" type="row" />
                <field name="resolution_hours" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="helpdesk_ticket_report_aht_view_graph" model="ir.ui.view">
        <field name="name">helpdesk.ticket.report.aht.view.graph</field>
        <field name="model">helpdesk.ticket.report.aht</field>
        <field name="arch" type="xml">
            <graph string="Average Handling Time Analysis" type="bar">
                <field name="team_id" />
                <field name="resolution_hours" type="measure" />
            </graph>
        </field>
    </record>

    <!-- List View -->
    <record id="helpdesk_ticket_report_aht_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.report.aht.view.list</field>
        <field name="model">helpdesk.ticket.report.aht</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="ticket_id" />
                <field name="team_id" />
                <field name="category_id" />
                <field name="user_id" />
                <field name="stage_id" />
                <field name="create_date" />
                <field name="closed_date" />
                <field name="resolution_hours" widget="float_time" />
                <field name="assign_hours" widget="float_time" />
                <field name="sla_breached" />
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="helpdesk_ticket_report_aht_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.report.aht.view.search</field>
        <field name="model">helpdesk.ticket.report.aht</field>
        <field name="arch" type="xml">
            <search>
                <field name="ticket_id" />
                <field name="team_id" />
                <field name="category_id" />
                <field name="user_id" />
                <filter string="Closed Tickets" name="closed_tickets" domain="[('is_closed', '=', True)]" />
                <filter string="This Month" name="this_month" domain="[('create_date', '&gt;=', (context_today()).strftime('%%Y-%%m-01'))]" />
                <filter string="Last 30 Days" name="last_30_days" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%%Y-%%m-%%d'))]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter string="Team" name="group_team" context="{'group_by': 'team_id'}" />
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}" />
                    <filter string="Assigned User" name="group_user" context="{'group_by': 'user_id'}" />
                    <filter string="Month" name="group_month" context="{'group_by': 'create_date:month'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_helpdesk_ticket_report_aht" model="ir.actions.act_window">
        <field name="name">Handling Time</field>
        <field name="res_model">helpdesk.ticket.report.aht</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{
            'search_default_closed_tickets': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data available for Average Handling Time.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="helpdesk_ticket_report_aht_menu"
              name="Handling Time"
              parent="helpdesk_mgmt.helpdesk_ticket_reporting_menu"
              action="action_helpdesk_ticket_report_aht"
              sequence="10"
              groups="helpdesk_mgmt.group_helpdesk_manager" />
</odoo>
