<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Ticket Tree View Inheritance -->
    <record id="ticket_view_tree_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.list.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_tree" />
        <field name="arch" type="xml">
            <!-- Insert traffic light as the first column before priority -->
            <xpath expr="//field[@name='priority']" position="before">
                <field name="sla_expired" column_invisible="True" />
                <field name="sla_deadline" column_invisible="True" />
                <field name="sla_status" widget="sla_traffic_light" />
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">sla_expired</attribute>
            </xpath>
        </field>
    </record>

    <!-- Ticket Kanban View Inheritance -->
    <record id="view_helpdesk_ticket_kanban_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_ticket_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="sla_status" invisible="1" />
                <field name="sla_deadline" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='number']" position="before">
                <field name="sla_status" widget="sla_traffic_light" class="me-1" />
            </xpath>
        </field>
    </record>

    <!-- Ticket Form View Inheritance -->
    <record id="ticket_view_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']/h1" position="after">
                <div class="mb-2">
                    <field
                        name="sla_status"
                        widget="badge"
                        decoration-danger="sla_status == 'expired'"
                        decoration-warning="sla_status == 'warning'"
                        decoration-success="sla_status == 'on_time'"
                        decoration-muted="sla_status == 'no_sla'"
                    />
                </div>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="allowed_category_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_category_ids)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Ticket Search View Inheritance -->
    <record id="helpdesk_ticket_view_search_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.search.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search" />
        <field name="arch" type="xml">
            <!-- Add filters in the filters section -->
            <xpath expr="//filter[@name='archived']" position="before">
                <filter
                    string="SLA Expired"
                    name="sla_expired"
                    domain="[('sla_status', '=', 'expired')]"
                />
                <filter
                    string="SLA On Time"
                    name="sla_on_time"
                    domain="[('sla_status', '=', 'on_time')]"
                />
                <filter
                    string="SLA Warning"
                    name="sla_warning"
                    domain="[('sla_status', '=', 'warning')]"
                />
                <separator />
            </xpath>
            <!-- Add group by filter -->
            <xpath expr="//search/group" position="inside">
                <filter
                    string="SLA Status"
                    name="group_sla_status"
                    domain="[]"
                    context="{'group_by': 'sla_status'}"
                />
                <filter
                    string="SLA Type"
                    name="group_sla_id"
                    domain="[]"
                    context="{'group_by': 'sla_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
