<odoo>
    <record id="helpdesk_ticket_sla_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.sla.form.inherit</field>
        <field name="model">helpdesk.sla</field>
        <field name="inherit_id" ref="helpdesk_mgmt_sla.helpdesk_ticket_sla_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_ids']" position="before">
                <field name="excluded_category_ids" invisible="1"/>
                <field name="allowed_category_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='category_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_category_ids), ('id', 'not in', excluded_category_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
